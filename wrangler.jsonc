{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "imtiyaz-tajseeds",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-30",
  // Keep variables/secrets added in the Cloudflare dashboard when deploying
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    // Pages and photos in public/ are served for free without running the Worker.
    // Only these dynamic paths run it (each run counts toward the 100,000/day free limit).
    "run_worker_first": ["/api/*", "/data/*", "/uploads/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tajseeds",
      "database_id": "b20a53d7-d5dc-4b8c-b203-6927ce0d6882",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
