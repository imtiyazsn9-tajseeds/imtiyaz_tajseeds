# Copy to .env and run with:  node --env-file=.env server/index.js
PORT=8080
HOST=0.0.0.0

# Admin panel login. Change the password before putting the site online.
ADMIN_ID=tajseeds
ADMIN_PASSWORD=change-me

# Set to 1 only when running behind a reverse proxy (nginx, Cloudflare) so login
# rate limiting uses the visitor's real IP.
TRUST_PROXY=0

# Optional: also forward every contact-form enquiry to this URL (JSON POST).
# Example with Formspree: https://formspree.io/f/<your-form-id>
NOTIFY_WEBHOOK_URL=
